# ---------------------------------------------------------------------------
# Supabase (production data layer)
# Leave these unset to run on the built-in local fallback store (see README).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin panel + server actions. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma separated list of emails bootstrapped as `admin` on first sign-in.
ADMIN_EMAILS=

# WhatsApp number for click-to-chat (digits only, incl. country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=911234567890
NEXT_PUBLIC_CONTACT_EMAIL=care@example.com
